{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "targetDefaults": {
    "generate": {
      "cache": true
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^generate"],
      "inputs": ["default", "^default", { "runtime": "deno --version" }]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default", { "runtime": "deno --version" }]
    },
    "lint": {
      "cache": true,
      "inputs": ["default"]
    },
    "format": {
      "cache": true,
      "inputs": ["default"]
    }
  }
}
