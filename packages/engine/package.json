{
  "name": "@kuib-ai/engine",
  "version": "0.0.1",
  "description": "kuib engine \u2014 agent loop, event log, daemon dispatch",
  "type": "module",
  "imports": {
    "#*": "./src/*/index.ts",
    "#*.ts": "./src/*.ts",
    "#*.json": "./src/*.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "deno test -A --no-check",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/groq": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/openai-compatible": "catalog:",
    "@kuib-ai/daemon": "workspace:*",
    "@kuib-ai/protocol": "workspace:*",
    "@kuib-ai/std": "workspace:*",
    "@kuib-ai/tools": "workspace:*",
    "@std/toml": "catalog:",
    "@trpc/client": "catalog:",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kuib-ai/deno-types": "workspace:*",
    "@kuib-ai/tsconfig": "workspace:*",
    "@std/expect": "catalog:",
    "@std/testing": "catalog:",
    "@types/node": "catalog:"
  }
}
