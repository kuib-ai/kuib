{
  "name": "@kuib-ai/daemon",
  "version": "0.0.1",
  "description": "kuib node-local fs/shell executor (tRPC)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "deno test -A --no-check",
    "start": "deno run -A src/start.daemon/index.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@kuib-ai/config": "workspace:*",
    "@kuib-ai/protocol": "workspace:*",
    "@kuib-ai/std": "workspace:*",
    "@trpc/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kuib-ai/deno-types": "workspace:*",
    "@kuib-ai/tsconfig": "workspace:*",
    "@std/expect": "catalog:",
    "@std/testing": "catalog:",
    "@types/node": "catalog:"
  }
}
