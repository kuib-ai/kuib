{"model":"claude-haiku-4-5-20251001","max_tokens":2048,"stream":false,"system":"Keep the answer short.","messages":[{"role":"user","content":"Find the unique integer selector from 1 through 99 that has remainder 2 when divided by 5, remainder 0 when divided by 7, and remainder 7 when divided by 11. Work out the constraints before answering. Use get_value with the derived selector to obtain the stored value. Do not guess the stored value."}],"thinking":{"type":"enabled","budget_tokens":1024,"display":"summarized"},"tools":[{"name":"get_value","description":"Return the stored integer for the selector.","input_schema":{"type":"object","properties":{"selector":{"type":"integer"}},"required":["selector"],"additionalProperties":false}}],"tool_choice":{"type":"auto"}}