{
  "name": "@kuib-ai/config",
  "version": "0.0.1",
  "description": "kuib configuration loading, precedence, and application paths",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "deno test -A --no-check",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@kuib-ai/env": "workspace:*",
    "@kuib-ai/std": "workspace:*",
    "@std/toml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kuib-ai/deno-types": "workspace:*",
    "@kuib-ai/tsconfig": "workspace:*",
    "@std/expect": "catalog:",
    "@std/testing": "catalog:",
    "@types/node": "catalog:"
  }
}
