{
  "name": "@kuib-ai/host-tui",
  "version": "0.0.1",
  "description": "Terminal host for Kuib AI",
  "type": "module",
  "scripts": {
    "dev": "deno run -A src/index.ts",
    "dev:watch": "deno run -A --watch src/index.ts",
    "typecheck": "tsgo --noEmit",
    "test": "deno test -A --no-check",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@kuib-ai/cli": "workspace:*",
    "@kuib-ai/config": "workspace:*",
    "@kuib-ai/daemon": "workspace:*",
    "@kuib-ai/engine": "workspace:*",
    "@kuib-ai/engine-service": "workspace:*",
    "@kuib-ai/event-log-sqlite": "workspace:*",
    "@kuib-ai/protocol": "workspace:*",
    "@kuib-ai/std": "workspace:*",
    "@kuib-ai/telemetry": "workspace:*",
    "@kuib-ai/transcript": "workspace:*"
  },
  "devDependencies": {
    "@kuib-ai/deno-types": "workspace:*",
    "@kuib-ai/tsconfig": "workspace:*",
    "@std/expect": "catalog:",
    "@std/testing": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
