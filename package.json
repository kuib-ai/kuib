{
  "name": "@kuib-ai/kuib",
  "version": "0.0.1",
  "description": "kuib ai bitch",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "format:modified": "prettier --write $(git ls-files --others --exclude-standard --modified)",
    "format:all": "prettier --write .",
    "lint:all": "eslint",
    "check:base": "deno run --allow-read scripts/check.root.manifest.ts && deno run -A tooling/agents.ts check && deno run -A tooling/journal.ts check && prettier --check . && pnpm run check:circular",
    "check": "pnpm run check:base && nx run-many -t typecheck lint test",
    "check:affected": "pnpm run check:base && nx affected -t typecheck lint test",
    "check:circular": "madge --circular --extensions ts,tsx packages apps",
    "agents": "deno run -A tooling/agents.ts",
    "journal": "deno run -A tooling/journal.ts",
    "orchestra": "deno run -A tooling/orchestra.ts",
    "roadmap": "deno run -A scripts/roadmap.ts",
    "roadmap:serve": "deno run -A scripts/roadmap.serve.ts",
    "typecheck": "nx run-many -t typecheck --output-style=stream",
    "test": "testing",
    "capture": "inference",
    "test:live": "nx run-many -t test:live",
    "bench": "nx run-many -t bench",
    "test:llm": "cd packages/engine && KUIB_LLM_TESTS=1 deno test -A --no-check src/provider/live.test.ts",
    "reload": "deno run -A scripts/reload.ts",
    "design": "./scripts/design-session.sh"
  },
  "keywords": [],
  "author": {
    "url": "https://github.com/roysupriyo10",
    "name": "Supriyo Roy",
    "email": "supriyo@kuib.ai"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuib-ai/kuib"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engineStrict": true,
  "engines": {
    "node": "25.4.0"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@kuib-ai/testing": "workspace:*",
    "@kuib-ai/inference": "workspace:*",
    "@mermaid-js/layout-elk": "catalog:",
    "@typescript/native-preview": "catalog:",
    "beautiful-mermaid": "catalog:",
    "deno": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "madge": "catalog:",
    "mermaid": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "nx": {
    "includedScripts": [
      "format:all"
    ]
  },
  "dependencies": {
    "@trpc/server": "catalog:"
  }
}
