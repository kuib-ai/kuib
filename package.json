{
  "name": "@kuib-ai/kuib",
  "version": "0.0.1",
  "description": "kuib ai bitch",
  "scripts": {
    "format:modified": "prettier --write $(git ls-files --others --exclude-standard --modified)",
    "format:all": "prettier --write .",
    "lint:all": "eslint",
    "check": "deno run --allow-read scripts/check.root.manifest.ts && deno run -A tooling/agents.ts check && deno run -A tooling/journal.ts check && nx run-many --parallel=10 -t typecheck lint format",
    "check:circular": "madge --circular --extensions ts,tsx packages apps",
    "agents": "deno run -A tooling/agents.ts",
    "journal": "deno run -A tooling/journal.ts",
    "orchestra": "deno run -A tooling/orchestra.ts",
    "typecheck": "nx run-many -t typecheck --output-style=stream",
    "test": "nx run-many -t test",
    "test:llm": "cd packages/engine && KUIB_LLM_TESTS=1 deno test -A --no-check src/provider/live.test.ts",
    "reload": "deno run -A scripts/reload.ts",
    "design": "./scripts/design-session.sh"
  },
  "keywords": [],
  "author": {
    "url": "https://github.com/roysupriyo10",
    "name": "Supriyo Roy",
    "email": "supriyo@kuib.ai"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuib-ai/kuib"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engineStrict": true,
  "engines": {
    "node": "25.4.0"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@typescript/native-preview": "catalog:",
    "deno": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "madge": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "nx": {
    "includedScripts": [
      "format:all"
    ]
  },
  "dependencies": {
    "@trpc/server": "catalog:"
  }
}
