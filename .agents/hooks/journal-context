#!/usr/bin/env bash
set -euo pipefail

format="${1:?format: claude|gemini|cursor}"
event="${2:-session-start}"

root="${CLAUDE_PROJECT_DIR:-${GEMINI_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-}}}"
[ -n "$root" ] || root=$(git rev-parse --show-toplevel)
cd "$root"

if [ "$format" = "claude" ] && [ -n "${CURSOR_PROJECT_DIR:-}" ]; then
  exit 0
fi

if [ "$format" = "cursor" ] && [ "$event" = "pre-compact" ]; then
  printf '%s\n' '{"user_message":"Context is about to be compacted. Afterwards, run /remember <feature-name> to reload the feature plan and its domain context."}'
  exit 0
fi

deno="./node_modules/.bin/deno"
journal="tooling/journal.ts"
failing=()
if ! "$deno" run -A "$journal" check >/dev/null 2>&1; then
  failing=(--failing)
fi
exec "$deno" run -A "$journal" brief --hook "$format" ${failing[@]+"${failing[@]}"}
